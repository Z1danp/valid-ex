# Neon pooled connection. The host must be the pooler endpoint (contains "-pooler").
# @valid-ex/db opens it with the @neondatabase/serverless WebSocket Pool so a
# calibration batch and its audit log commit in one ACID transaction.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/valid_ex?sslmode=require
