        },
        "check_provider_identity": {
          "name": "check_provider_identity",
          "value": "(\n        (\"users\".\"auth_provider\" = 'local' AND \"users\".\"password_hash\" IS NOT NULL AND \"users\".\"google_id\" IS NULL)\n        OR\n        (\"users\".\"auth_provider\" = 'google' AND \"users\".\"password_hash\" IS NULL AND \"users\".\"google_id\" IS NOT NULL)\n      )"
        },
