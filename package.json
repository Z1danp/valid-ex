{
  "name": "valid-ex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable Statistical Calibration & Native Formula Excel Engine for Analytical Chemistry (ISO/IEC 17025)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:math": "pnpm --filter @valid-ex/math test",
    "typecheck": "pnpm -r typecheck",
    "gen:contracts": "pnpm --filter @valid-ex/contracts gen",
    "dev:web": "pnpm --filter @valid-ex/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
